# Postgres. Locally this is your own instance; on Vercel use a hosted one
# (Neon, Supabase, Vercel Postgres).
#
# DATABASE_URL is the pooled connection the app runs on.
# DIRECT_URL is the unpooled one — `prisma db push` and migrations need it,
# because a connection pooler cannot carry schema changes.
DATABASE_URL="postgresql://user:password@host/codeshelf?sslmode=require"
DIRECT_URL="postgresql://user:password@host/codeshelf?sslmode=require"

# Where local backups are written. Ignored on a serverless host, which has
# no disk that survives a request.
BACKUP_STORAGE_PATH="/tmp/codeshelf-backups"

# Disk-bound features: folder scanning, open-in-editor, backups.
# Unset, they follow the host: on by default, off on Vercel.
# Force with 1/true or 0/false.
# CODESHELF_DESKTOP=1

# Editor launcher for "open in editor". Falls back to cursor/code/zed/subl.
# CODESHELF_EDITOR=cursor
