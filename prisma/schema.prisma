generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  passwordHash  String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts    Account[]
  sessions    Session[]
  projects    Project[]
  collections Collection[]
  tags        Tag[]
  backups     Backup[]
  setting     Setting?
  cloudConnections CloudConnection[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Project {
  id          String   @id @default(cuid())
  userId      String
  name        String
  path        String
  description String?  @db.Text
  language    String?
  framework   String?
  packageManager String?
  size        BigInt   @default(0)
  lastModified DateTime?
  lastOpened  DateTime?
  readme      String?  @db.Text
  notes       String?  @db.Text

  // Git info
  isGitRepo     Boolean @default(false)
  gitBranch     String?
  gitRemote     String?
  gitStatus     String? // clean, dirty, ahead, behind
  gitLastCommit DateTime?
  gitCommitCount Int?

  // Status
  isFavorite  Boolean  @default(false)
  isArchived  Boolean  @default(false)
  isPinned    Boolean  @default(false)
  status      String   @default("active") // active, archived, needs-attention

  // Detection
  hasPackageJson   Boolean @default(false)
  hasRequirements  Boolean @default(false)
  hasCargo         Boolean @default(false)
  hasGoMod         Boolean @default(false)
  hasPubspec       Boolean @default(false)
  hasGemfile       Boolean @default(false)
  hasPomXml        Boolean @default(false)

  // Dependencies stored as JSON
  dependencies     String? @db.Text // JSON array
  devDependencies  String? @db.Text // JSON array
  scripts          String? @db.Text // JSON array
  fileStructure    String? @db.Text // JSON tree

  // Duplicate detection
  structureHash    String?
  contentHash      String?
  duplicateGroupId String?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tags        ProjectTag[]
  collections ProjectCollection[]
  backups     Backup[]

  @@index([userId])
  @@index([language])
  @@index([framework])
  @@index([isFavorite])
  @@index([isArchived])
  @@index([gitRemote])
  @@index([structureHash])
  @@index([duplicateGroupId])
}

model Tag {
  id       String @id @default(cuid())
  name     String
  color    String @default("#6366f1")
  userId   String

  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  projects ProjectTag[]

  @@unique([userId, name])
}

model ProjectTag {
  projectId String
  tagId     String

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tag     Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([projectId, tagId])
}

model Collection {
  id          String   @id @default(cuid())
  name        String
  description String?
  icon        String?  @default("folder")
  color       String?  @default("#6366f1")
  userId      String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user     User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  projects ProjectCollection[]

  @@unique([userId, name])
}

model ProjectCollection {
  projectId    String
  collectionId String

  project    Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  collection Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)

  @@id([projectId, collectionId])
}

model Backup {
  id            String   @id @default(cuid())
  projectId     String
  userId        String
  provider      String   @default("local") // local, google-drive, s3
  storagePath   String
  size          BigInt   @default(0)
  fileCount     Int      @default(0)
  status        String   @default("pending") // pending, in-progress, completed, failed
  progress      Float    @default(0) // 0-100
  error         String?
  checksum      String?
  excludedPaths String?  @db.Text // JSON array
  createdAt     DateTime @default(now())
  completedAt   DateTime?

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([userId])
  @@index([status])
}

model CloudConnection {
  id           String   @id @default(cuid())
  userId       String
  provider     String
  accountEmail String?
  accountName  String?
  folderId     String?
  folderName   String?
  accessToken  String?  @db.Text
  refreshToken String?  @db.Text
  expiresAt    DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, provider])
  @@index([userId])
}

model Setting {
  id              String   @id @default(cuid())
  userId          String   @unique
  backupPath      String   @default("/tmp/codeshelf-backups")
  defaultProvider String   @default("local")
  autoBackup      Boolean  @default(false)
  notifications   Boolean  @default(true)
  updatedAt       DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}
